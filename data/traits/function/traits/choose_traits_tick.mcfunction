# Reset attributes
attribute @s minecraft:attack_damage base reset
attribute @s minecraft:attack_knockback base reset
attribute @s minecraft:attack_speed base reset
attribute @s minecraft:block_interaction_range base reset
attribute @s minecraft:entity_interaction_range base reset
attribute @s minecraft:fall_damage_multiplier base reset
attribute @s minecraft:gravity base reset
attribute @s minecraft:knockback_resistance base reset
attribute @s minecraft:max_health base reset
attribute @s minecraft:movement_speed base reset
attribute @s minecraft:step_height base reset

# Remove infinite effects
execute as @s[nbt={active_effects:[{duration:-1,id:'minecraft:blindness'}]}] run effect clear @s minecraft:blindness
execute as @s[nbt={active_effects:[{duration:-1,id:'minecraft:fire_resistance'}]}] run effect clear @s minecraft:fire_resistance
execute as @s[nbt={active_effects:[{duration:-1,id:'minecraft:night_vision'}]}] run effect clear @s minecraft:night_vision

# Take recipies
recipe take @s *

# Take role ability
function traits:traits/take_ability

# Enable the traits trigger for the player
scoreboard players enable @s traits

# Take the traits book if offhand is occupied
execute as @a[team=] unless predicate traits:holding_traits_book run clear @s minecraft:written_book[minecraft:custom_data={traits_book:true}]

# Give the player the traits book
